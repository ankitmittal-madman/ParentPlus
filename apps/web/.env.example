# ParentPlus web configuration template
# Copy to .env.local and supply development project values.
# Never add service-role keys or database passwords here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Live OTP delivery is disabled until explicitly enabled.
NEXT_PUBLIC_ENABLE_LIVE_OTP=false

# Local UI opt-in only; this is not a provider-side signup restriction.
NEXT_PUBLIC_ENABLE_ACCOUNT_SIGNUP=false

# Local server-side parent profile read draft; also requires its database control.
PARENTPLUS_ENABLE_PARENT_CHILD_LIST=false

# Navigation visibility only; does not authorize profile access.
NEXT_PUBLIC_ENABLE_PARENT_PROFILE_LINK=false

# Local server-side child-creation draft; requires the database control too.
PARENTPLUS_ENABLE_CHILD_CREATION=false
